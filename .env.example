# ---------------------------------------------------------------------------
# Profile Photo Generator - configuration
#
# Copy to `.env` and edit. Every value below is a default, so an empty .env
# works fine on a machine with an NVIDIA GPU and Ollama on the host.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Address uvicorn binds inside the container. Leave at 0.0.0.0: what decides
# whether the service is reachable from the network is PPG_BIND_ADDRESS below,
# not this.
PPG_HOST=0.0.0.0
PPG_PORT=8000

# Which host interface Docker publishes the port on. Loopback by default, so a
# fresh `docker compose up -d` is not reachable from the network.
#
# To expose it, do both of these, in this order:
#   1. set PPG_API_KEY to a long random string
#   2. set PPG_BIND_ADDRESS=0.0.0.0
# There is no rate limiting, and generation costs GPU time.
PPG_BIND_ADDRESS=127.0.0.1

# Leave empty for no authentication (fine on loopback).
# REQUIRED before exposing the service beyond localhost. Clients then send
# `Authorization: Bearer <key>`.
PPG_API_KEY=

# Comma-separated allowed CORS origins. "*" is fine for local development.
PPG_CORS_ORIGINS=*

# --- Image backend ----------------------------------------------------------
# diffusers      - local SDXL via the diffusers library (default, needs a GPU)
# fake           - deterministic placeholder images, no model. Used by the test
#                  suite and CI; also handy to try the API without downloading 7GB.
# openai_images  - forward to any OpenAI-compatible /v1/images/generations
#                  endpoint (this is how Ollama will plug in once its image
#                  generation supports Linux).
PPG_BACKEND=diffusers

# auto | cuda | cpu. "cpu" works but takes minutes per image.
PPG_DEVICE=auto

# Model + VAE. The separate fp16-fix VAE is required: SDXL's stock VAE produces
# black images in float16.
PPG_MODEL_ID=SG161222/RealVisXL_V5.0
PPG_VAE_ID=madebyollin/sdxl-vae-fp16-fix

# Sampling defaults. RealVisXL V5 prefers a low guidance scale.
PPG_STEPS=30
PPG_FAST_STEPS=15
PPG_GUIDANCE=4.5
PPG_WIDTH=1024
PPG_HEIGHT=1024

# Trade VRAM for speed. Enable low_vram on cards below ~10GB.
PPG_LOW_VRAM=false
# torch.compile gives ~15% faster inference but adds minutes to the first run.
PPG_COMPILE=false

# Only used when PPG_BACKEND=openai_images
PPG_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
PPG_OPENAI_API_KEY=
PPG_OPENAI_MODEL=x/z-image-turbo

# --- Prompt composer --------------------------------------------------------
# OLLAMA IS OPTIONAL. With no Ollama running, prompts are built from templates
# and everything works. Ollama only makes the wording more varied and the
# persona metadata richer.
#
# auto     - use Ollama if it is reachable, otherwise use templates (default)
# llm      - require Ollama, fail loudly if it is not there
# template - never call Ollama, not even if it is running
PPG_COMPOSER=auto

# From inside Docker this is http://host.docker.internal:11434 (already set in
# compose.yaml). On the host it is http://127.0.0.1:11434.
PPG_OLLAMA_BASE_URL=http://127.0.0.1:11434

# "auto" picks whichever model you already have, preferring a small one, so you
# never need to pull anything just for this project. Set an explicit tag
# (llama3.2:3b, qwen3:4b, ...) to pin it.
PPG_OLLAMA_MODEL=auto
PPG_OLLAMA_TIMEOUT=90

# How long Ollama keeps the prompt model in VRAM after use.
# "0" unloads it immediately. Keep this at 0 when Ollama and the image model
# share one GPU - an 8B model parked on 5GB is the most common cause of CUDA
# out-of-memory errors here. Set "5m" if Ollama runs on another machine.
PPG_OLLAMA_KEEP_ALIVE=0

# --- Storage ----------------------------------------------------------------
# Images, SQLite database and the prompt cache all live here.
PPG_DATA_DIR=./data

# Sizes written for every avatar, in both WebP and PNG. The model always
# renders at PPG_WIDTH x PPG_HEIGHT; the result is centre-cropped square and
# then downscaled to each of these.
PPG_SIZES=1024,512,256,128
PPG_WEBP_QUALITY=90

# Where model weights are cached. Inside Docker this is a named volume.
HF_HOME=

# --- Safety -----------------------------------------------------------------
# Ages are clamped to this range. See docs and SECURITY.md before changing.
PPG_MIN_AGE=18
PPG_MAX_AGE=90
# Allows generating faces under PPG_MIN_AGE. Doing so also forces plain
# school-portrait framing and ignores clothing/expression overrides.
PPG_ALLOW_MINORS=false

# --- Queue ------------------------------------------------------------------
PPG_MAX_QUEUE=128
# Seconds a POST /v1/avatars request will block waiting for its result before
# returning 202 + a job id instead.
PPG_DEFAULT_WAIT=60
